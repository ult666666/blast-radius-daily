{
  "private": true,
  "name": "blast-radius-daily",
  "version": "0.1.0",
  "description": "A daily community schema-lineage puzzle built with Devvit Web and Phaser.",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:demo": "tsx scripts/build-demo.ts",
    "test:demo": "npm run build:demo && playwright test",
    "deploy": "npm run verify && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run verify && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.ts'",
    "login": "devvit login",
    "preview:local": "vite --config vite.local.config.ts --host 127.0.0.1",
    "prettier": "prettier --write .",
    "screenshots": "bash scripts/capture-screenshots.sh",
    "test": "tsx --test test/**/*.test.ts",
    "type-check": "tsc --build",
    "verify": "npm run type-check && npm run lint && npm test && npm run build && npm run build:demo"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@devvit/start": "0.13.7",
    "@devvit/web": "0.13.7",
    "@hono/node-server": "2.1.5",
    "devvit": "0.13.7",
    "hono": "4.13.13",
    "phaser": "4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.19",
    "eslint": "10.6.0",
    "globals": "17.7.0",
    "prettier": "3.9.4",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.3.5"
  },
  "overrides": {
    "image-size@2.0.2": "2.0.3",
    "js-yaml@4.2.0": "4.3.2",
    "protobufjs@7.6.3": "7.6.5",
    "tmp@0.0.33": "0.2.7"
  }
}
